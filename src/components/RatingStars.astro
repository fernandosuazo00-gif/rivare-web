---
interface Props {
  rating: number;
  class?: string;
}
const { rating, class: className } = Astro.props;
const pct = Math.max(0, Math.min(100, (rating / 5) * 100));
---

<span class:list={['relative inline-block leading-none tracking-[0.1em] text-[0.85rem] shrink-0', className]} aria-hidden="true">
  <span class="text-sand">★★★★★</span>
  <span class="absolute inset-y-0 left-0 overflow-hidden text-caramel-deep whitespace-nowrap" style={`width:${pct}%`}>★★★★★</span>
</span>
