---
import CatalogProductCard from '@/components/CatalogProductCard.astro';
import type { Product } from '@/data/products';

interface Props {
  products: Product[];
  /** how many images load eagerly (above the fold) */
  eager?: number;
  class?: string;
}
const { products, eager = 4, class: className } = Astro.props;
---

<div
  class:list={[
    'flex flex-col gap-3 sm:gap-4 lg:grid lg:grid-cols-3 lg:gap-x-6 lg:gap-y-14 xl:grid-cols-4',
    className,
  ]}
>
  {products.map((product, i) => (
    <CatalogProductCard product={product} index={i} loading={i < eager ? 'eager' : 'lazy'} />
  ))}
</div>

<p data-catalog-empty hidden class="mt-10 text-center text-taupe-deep">
  No encontramos perfumes con esos filtros. Probá quitando alguno.
</p>
