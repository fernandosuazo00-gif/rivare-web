---
/**
 * Minimal line-icon set (no emoji, single 24x24 viewBox, currentColor).
 */
interface Props {
  name: 'cart' | 'menu' | 'close' | 'arrow-right' | 'arrow-down' | 'plus' | 'minus' | 'whatsapp' | 'instagram';
  class?: string;
  size?: number;
}
const { name, class: className, size = 24 } = Astro.props;

const paths: Record<Props['name'], string> = {
