---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { NAV_GROUPS, SITE } from '@/data/site';
import { waLink, GENERIC_WA_TEXT } from '@/lib/whatsapp';
import wordmarkInk from '@/assets/brand/wordmark-ink.png';
import wordmarkCream from '@/assets/brand/wordmark-cream.png';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div
  id="site-header"
  data-overlay={overlay ? '' : undefined}
  class:list={[
    'fixed inset-x-0 top-0 z-header transition-[background-color,border-color,color] duration-300',
    overlay
      ? 'text-ivory bg-transparent border-b border-transparent [&.is-scrolled]:bg-espresso [&.is-scrolled]:border-white/10'
      : 'text-ink bg-paper/95 supports-[backdrop-filter]:bg-paper/80 backdrop-blur-sm border-b border-sand',
  ]}
>
  <!-- Announcement bar -->
  <div class="h-8 flex items-center justify-center bg-espresso text-ivory overflow-hidden px-4">
    <p class="sm:hidden text-[0.625rem] uppercase tracking-[0.08em] whitespace-nowrap text-ellipsis overflow-hidden text-center max-w-full">
      {SITE.brandLineShort}
    </p>
    <p class="hidden sm:block text-[0.6875rem] uppercase tracking-[0.16em] whitespace-nowrap text-ellipsis overflow-hidden text-center max-w-full">
      {SITE.brandLine}
    </p>
  </div>

  <!-- Main header row -->
  <div class="u-shell flex items-center justify-between gap-3 h-16 lg:h-20">
    <!-- Mobile: hamburger left -->
    <button
      type="button"
      data-menu-open
      class="lg:hidden inline-flex items-center justify-center w-11 h-11 -ml-1"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <Icon name="menu" size={22} />
    </button>

    <!-- Wordmark -->
    <a href="/" class="shrink-0 py-2 lg:mr-2" aria-label={`${SITE.name} — inicio`}>
      <Image
        src={wordmarkInk}
        alt=""
        widths={[80, 160]}
        sizes="80px"
        class:list={['h-[19px] w-auto lg:h-[22px]', overlay ? 'hidden [.is-scrolled_&]:hidden' : 'block']}
        loading="eager"
      />
      <Image
        src={wordmarkCream}
        alt=""
        widths={[80, 160]}
        sizes="80px"
        class:list={['h-[19px] w-auto lg:h-[22px]', overlay ? 'block [.is-scrolled_&]:block' : 'hidden']}
        loading="eager"
      />
    </a>

    <!-- Desktop nav: grouped dropdowns -->
    <nav class="hidden lg:flex items-center gap-8 text-meta uppercase tracking-[0.15em] mr-auto ml-6" aria-label="Principal">
      {NAV_GROUPS.map((group) => (
        <div class="relative group">
          {group.href ? (
            <a href={group.href} class="inline-flex items-center gap-1.5 py-6" aria-current={isActive(group.href) ? 'page' : undefined}>
              <span class="link-underline">{group.label}</span>
              <Icon name="arrow-down" size={12} class="opacity-60 transition-transform duration-200 group-hover:rotate-180" />
            </a>
          ) : (
            <button type="button" class="inline-flex items-center gap-1.5 py-6 cursor-default">
              <span class="link-underline">{group.label}</span>
              <Icon name="arrow-down" size={12} class="opacity-60 transition-transform duration-200 group-hover:rotate-180" />
            </button>
          )}
          <div class="absolute left-0 top-full min-w-[240px] bg-paper text-ink border border-sand p-2 opacity-0 invisible translate-y-1 transition-all duration-200 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0">
            {group.items.map((item) => (
              <a href={item.href} class="block px-3 py-2.5 text-meta uppercase tracking-[0.14em] hover:bg-ivory transition-colors">
                {item.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href={waLink(GENERIC_WA_TEXT)}
        target="_blank"
        rel="noopener"
        class="hidden xl:inline-flex items-center gap-2 text-meta uppercase tracking-[0.14em] px-3 py-2 hover:text-caramel-deep transition-colors [[data-overlay].is-scrolled_&]:hover:text-caramel"
      >
        <Icon name="whatsapp" size={16} />
        <span>WhatsApp</span>
      </a>

      <button
        type="button"
        data-search-open
        class="inline-flex items-center justify-center w-11 h-11 hover:text-caramel-deep transition-colors"
        aria-label="Buscar perfumes"
      >
        <Icon name="search" size={20} />
      </button>

      <button
        type="button"
        data-cart-open
        class="relative inline-flex items-center justify-center w-11 h-11 -mr-1 hover:text-caramel-deep transition-colors"
        aria-label="Abrir carrito"
      >
        <Icon name="cart" size={22} />
        <span
          data-cart-count
          hidden
          class="absolute top-1 right-0 min-w-[16px] h-4 px-1 grid place-items-center bg-caramel-deep text-paper text-[10px] font-medium rounded-full tabular-nums"
        >0</span>
      </button>
    </div>
  </div>
</div>

<!-- Mobile nav panel -->
<div id="mobile-nav" hidden class="fixed inset-0 z-mobile-nav lg:hidden is-dark flex flex-col">
  <div class="u-shell flex items-center justify-between h-16 border-b border-white/10">
    <Image src={wordmarkCream} alt={SITE.name} widths={[80, 160]} sizes="80px" class="h-[19px] w-auto" />
    <div class="flex items-center gap-1 -mr-1">
      <button type="button" data-search-open class="inline-flex items-center justify-center w-11 h-11" aria-label="Buscar perfumes">
        <Icon name="search" size={20} />
      </button>
      <button type="button" data-menu-close class="inline-flex items-center justify-center w-11 h-11" aria-label="Cerrar menú">
        <Icon name="close" size={22} />
      </button>
    </div>
  </div>

  <nav class="u-shell flex-1 overflow-y-auto py-6 flex flex-col" aria-label="Móvil">
    {NAV_GROUPS.map((group, i) => (
      <details class="group/d border-b border-white/10" open={i === 0}>
        <summary class="list-none flex items-center justify-between py-4 cursor-pointer select-none">
          <span class="eyebrow">{group.label}</span>
          <Icon name="arrow-down" size={14} class="opacity-60 transition-transform duration-200 group-open/d:rotate-180" />
        </summary>
        <div class="pb-4 flex flex-col">
          {group.items.map((item) => (
            <a href={item.href} class="py-2.5 font-display text-display-sm">{item.label}</a>
          ))}
        </div>
      </details>
    ))}

    <a href={waLink(GENERIC_WA_TEXT)} target="_blank" rel="noopener" class="btn btn--wa mt-8 w-full">
      <Icon name="whatsapp" size={18} />
      Escribinos por WhatsApp
    </a>
    <p class="text-meta text-sand/70 mt-4">{SITE.whatsapp.display} · {SITE.locality}, {SITE.countryName}</p>

    <p class="mt-auto pt-10 text-[0.6875rem] uppercase tracking-[0.24em] text-sand/40">
      Designed by <span class="text-sand/65">FStudio</span>
    </p>
  </nav>
</div>

<!-- Spacer so non-overlay pages don't hide under the fixed header -->
{!overlay && <div class="h-24 lg:h-28" aria-hidden="true"></div>}

<script>
  import { onCartChange, cartCount, readCart } from '@/lib/cart';

  const menuClose = () => {
    const panel = document.getElementById('mobile-nav');
    if (!panel || panel.hidden) return;
    panel.hidden = true;
    document.documentElement.classList.remove('no-scroll');
    document.querySelector('[data-menu-open]')?.setAttribute('aria-expanded', 'false');
    (document.querySelector('[data-menu-open]') as HTMLElement | null)?.focus();
  };
  const menuOpen = () => {
    const panel = document.getElementById('mobile-nav');
    if (!panel) return;
    panel.hidden = false;
    document.documentElement.classList.add('no-scroll');
    document.querySelector('[data-menu-open]')?.setAttribute('aria-expanded', 'true');
    panel.querySelector<HTMLElement>('a, button')?.focus();
  };

  function paintCount() {
    const n = cartCount(readCart());
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(n);
      el.hidden = n === 0;
    });
    document.querySelectorAll<HTMLElement>('[data-cart-open]').forEach((el) => {
      el.setAttribute('aria-label', n === 0 ? 'Abrir carrito' : `Abrir carrito, ${n} artículo${n === 1 ? '' : 's'}`);
    });
  }

  function syncHeaderScroll() {
    const header = document.getElementById('site-header');
    if (header?.hasAttribute('data-overlay')) {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    }
  }

  if (!(window as any).__rivareHeader) {
    (window as any).__rivareHeader = true;

    window.addEventListener('scroll', syncHeaderScroll, { passive: true });

    document.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('[data-cart-open]')) {
        window.dispatchEvent(new CustomEvent('rivare:cart-open'));
      } else if (el.closest('[data-search-open]')) {
        window.dispatchEvent(new CustomEvent('rivare:search-open'));
      } else if (el.closest('[data-menu-open]')) {
        menuOpen();
      } else if (el.closest('[data-menu-close]')) {
        menuClose();
      } else if (el.closest('#mobile-nav a')) {
        menuClose();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menuClose();
    });

    onCartChange(paintCount);
  }

  const boot = () => {
    menuClose();
    syncHeaderScroll();
    paintCount();
  };
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
