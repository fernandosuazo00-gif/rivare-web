---
import Icon from '@/components/Icon.astro';
import type { Product } from '@/data/products';
import type { CategorySlug } from '@/data/site';
import { SCENT_FAMILY_ORDER, SCENT_FAMILY_LABEL, GENDER_FILTER_LABEL } from '@/data/scentFamilies';

interface Props {
  products: Product[];
}
const { products } = Astro.props;

const GENDER_ORDER: CategorySlug[] = ['mujer', 'hombre', 'unisex'];
const gendersPresent = GENDER_ORDER.filter((g) => products.some((p) => p.category === g));
const showGenderFilter = gendersPresent.length > 1;

const scentsPresent = SCENT_FAMILY_ORDER.filter((f) => products.some((p) => p.scentFamily === f));

const total = products.length;
---

<!-- Filter drawer (opened by the 3 triggers in FilterTriggers.astro, matched
     purely via data-attributes — no DOM nesting requirement between them).
     Rendered as a sibling of the sticky category/filter bar (see
     CollectionView.astro), NOT nested inside it: that sticky bar has a
     `.reveal` ancestor using `will-change: transform`, and per the CSS spec
     `will-change: transform` establishes a new containing block for
     `position: fixed` descendants — so a fixed-position drawer nested inside
     it would be positioned relative to that sticky bar instead of the real
     viewport, which was the root cause of it rendering behind the header.
     Full-screen overlay on mobile/tablet (sits above the fixed header,
     safe-area aware), bottom-sheet on desktop (unchanged from before). -->
<div data-filter-backdrop hidden class="fixed inset-0 z-[105] bg-espresso/40 opacity-0 transition-opacity duration-300"></div>

<div
  data-filter-sheet
  hidden
  aria-hidden="true"
  role="dialog"
  aria-label="Filtros"
  class="filter-sheet fixed inset-x-0 top-0 lg:top-auto lg:bottom-0 z-[110] lg:max-h-[82vh] bg-paper lg:rounded-t-2xl -translate-y-full lg:translate-y-full transition-transform duration-300 ease-editorial flex flex-col shadow-[0_-10px_50px_rgba(42,32,24,0.18)]"
>
  <div class="filter-sheet__header flex items-center justify-between px-5 pb-4 border-b border-sand shrink-0">
    <p class="font-display text-[1.3rem]">Filtros</p>
    <button type="button" data-filter-close class="inline-flex items-center justify-center w-11 h-11 -mr-2" aria-label="Cerrar filtros">
      <Icon name="close" size={18} />
    </button>
  </div>

  <div class="flex-1 overflow-y-auto px-5 py-5 space-y-8">
    {showGenderFilter && (
      <section data-filter-section="gender">
        <p class="eyebrow mb-3">Gender</p>
        <div class="space-y-1">
          {gendersPresent.map((g) => (
            <label class="flex items-center gap-3 py-1.5 cursor-pointer select-none">
              <input type="checkbox" data-filter-gender value={g} class="peer sr-only" />
              <span class="w-5 h-5 shrink-0 border border-sand rounded-[3px] grid place-items-center transition-colors peer-checked:bg-espresso peer-checked:border-espresso">
                <Icon name="check" size={12} class="text-ivory opacity-0 peer-checked:opacity-100" />
              </span>
              <span class="text-[0.95rem]">{GENDER_FILTER_LABEL[g]}</span>
            </label>
          ))}
        </div>
      </section>
    )}

    {scentsPresent.length > 0 && (
      <section data-filter-section="scent">
        <p class="eyebrow mb-3">Scent Family</p>
        <div class="space-y-1">
          {scentsPresent.map((f) => (
            <label class="flex items-center gap-3 py-1.5 cursor-pointer select-none">
              <input type="checkbox" data-filter-scent value={f} class="peer sr-only" />
              <span class="w-5 h-5 shrink-0 border border-sand rounded-[3px] grid place-items-center transition-colors peer-checked:bg-espresso peer-checked:border-espresso">
                <Icon name="check" size={12} class="text-ivory opacity-0 peer-checked:opacity-100" />
              </span>
              <span class="text-[0.95rem]">{SCENT_FAMILY_LABEL[f]}</span>
            </label>
          ))}
        </div>
      </section>
    )}
  </div>

  <div class="filter-sheet__footer shrink-0 border-t border-sand px-5 pt-5 flex items-center gap-5">
    <button type="button" data-filter-clear class="text-meta uppercase tracking-[0.14em] text-taupe-deep underline underline-offset-4 shrink-0 whitespace-nowrap">
      Clear all
    </button>
    <button type="button" data-filter-show class="btn flex-1">
      Show results (<span data-filter-preview-count>{total}</span>)
    </button>
  </div>
</div>

<style>
  .filterbar-scroll {
    scrollbar-width: none;
  }
  .filterbar-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Mobile/tablet: true full-screen overlay, dvh-based so iOS Safari's
     collapsing address bar can't clip or over-extend the panel, with
     safe-area padding on the header/footer edges that touch the notch and
     home-indicator area. */
  .filter-sheet {
    height: 100dvh;
  }
  .filter-sheet__header {
    padding-top: max(1.25rem, calc(env(safe-area-inset-top, 0px) + 0.75rem));
  }
  .filter-sheet__footer {
    padding-bottom: max(1.25rem, calc(env(safe-area-inset-bottom, 0px) + 0.75rem));
  }

  /* Desktop: restore the original capped-height bottom-sheet exactly as before. */
  @media (min-width: 1024px) {
    .filter-sheet {
      height: auto;
    }
    .filter-sheet__header {
      padding-top: 1.25rem;
    }
    .filter-sheet__footer {
      padding-bottom: 1.25rem;
    }
  }
</style>

<script>
  type Applied = { gender: Set<string>; scent: Set<string> };
  interface Ctx {
    bar: HTMLElement;
    sheet: HTMLElement;
    backdrop: HTMLElement;
    cards: HTMLElement[];
    genderInputs: HTMLInputElement[];
    scentInputs: HTMLInputElement[];
    countEl: HTMLElement | null;
    emptyEl: HTMLElement | null;
    previewEl: HTMLElement | null;
    totalCountEl: HTMLElement | null;
    applied: Applied;
    isOpen: boolean;
    lastFocus: HTMLElement | null;
  }

  // Module-level (not re-created per navigation) so the ONE delegated listener
  // set below always reads the current page's DOM + filter state.
  let ctx: Ctx | null = null;

  function refresh() {
    const bar = document.querySelector<HTMLElement>('[data-filterbar]');
    const sheet = document.querySelector<HTMLElement>('[data-filter-sheet]');
    const backdrop = document.querySelector<HTMLElement>('[data-filter-backdrop]');
    if (!bar || !sheet || !backdrop) {
      ctx = null;
      return;
    }
    ctx = {
      bar,
      sheet,
      backdrop,
      cards: Array.from(document.querySelectorAll<HTMLElement>('[data-catalog-card]')),
      genderInputs: Array.from(sheet.querySelectorAll<HTMLInputElement>('[data-filter-gender]')),
      scentInputs: Array.from(sheet.querySelectorAll<HTMLInputElement>('[data-filter-scent]')),
      countEl: document.querySelector<HTMLElement>('[data-catalog-count]'),
      emptyEl: document.querySelector<HTMLElement>('[data-catalog-empty]'),
      previewEl: sheet.querySelector<HTMLElement>('[data-filter-preview-count]'),
      totalCountEl: bar.querySelector<HTMLElement>('[data-filter-total-count]'),
      applied: { gender: new Set(), scent: new Set() },
      isOpen: false,
      lastFocus: null,
    };
  }

  function matches(card: HTMLElement, gender: Set<string>, scent: Set<string>) {
    const g = card.dataset.gender ?? '';
    const s = card.dataset.scent ?? '';
    const genderOk = gender.size === 0 || gender.has(g);
    const scentOk = scent.size === 0 || scent.has(s);
    return genderOk && scentOk;
  }

  function draftSets(c: Ctx): Applied {
    return {
      gender: new Set(c.genderInputs.filter((i) => i.checked).map((i) => i.value)),
      scent: new Set(c.scentInputs.filter((i) => i.checked).map((i) => i.value)),
    };
  }

  function updatePreview(c: Ctx) {
    const draft = draftSets(c);
    const n = c.cards.reduce((sum, card) => sum + (matches(card, draft.gender, draft.scent) ? 1 : 0), 0);
    if (c.previewEl) c.previewEl.textContent = String(n);
  }

  function updatePillLabels(c: Ctx) {
    const genderPill = c.bar.querySelector<HTMLElement>('[data-filter-pill-label="gender"]');
    const scentPill = c.bar.querySelector<HTMLElement>('[data-filter-pill-label="scent"]');
    if (genderPill) genderPill.textContent = c.applied.gender.size ? `Gender (${c.applied.gender.size})` : 'Gender';
    if (scentPill) scentPill.textContent = c.applied.scent.size ? `Scent Family (${c.applied.scent.size})` : 'Scent Family';
    const totalActive = c.applied.gender.size + c.applied.scent.size;
    if (c.totalCountEl) {
      c.totalCountEl.hidden = totalActive === 0;
      c.totalCountEl.textContent = totalActive ? `(${totalActive})` : '';
    }
  }

  function applyFilters(c: Ctx) {
    const visible = c.cards.filter((card) => {
      const ok = matches(card, c.applied.gender, c.applied.scent);
      card.hidden = !ok;
      return ok;
    }).length;
    if (c.countEl) c.countEl.textContent = String(visible);
    if (c.emptyEl) c.emptyEl.hidden = visible !== 0;
    updatePillLabels(c);
  }

  function setOpen(c: Ctx, next: boolean, focusSection?: string) {
    c.isOpen = next;
    const { sheet, backdrop } = c;
    if (next) {
      c.genderInputs.forEach((i) => (i.checked = c.applied.gender.has(i.value)));
      c.scentInputs.forEach((i) => (i.checked = c.applied.scent.has(i.value)));
      updatePreview(c);

      c.lastFocus = document.activeElement as HTMLElement;
      backdrop.hidden = false;
      sheet.hidden = false;
      sheet.setAttribute('aria-hidden', 'false');
      void sheet.offsetWidth;
      backdrop.style.opacity = '1';
      sheet.style.transform = 'translateY(0)';
      document.documentElement.classList.add('no-scroll');
      sheet.querySelector<HTMLElement>('button, input')?.focus();

      if (focusSection && focusSection !== 'all') {
        window.setTimeout(() => {
          sheet.querySelector(`[data-filter-section="${focusSection}"]`)?.scrollIntoView({ block: 'nearest' });
        }, 60);
      }
    } else {
      backdrop.style.opacity = '0';
      sheet.style.transform = '';
      sheet.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('no-scroll');
      window.setTimeout(() => {
        if (!c.isOpen) {
          backdrop.hidden = true;
          sheet.hidden = true;
        }
      }, 320);
      c.lastFocus?.focus();
    }
  }

  if (!(window as any).__rivareFilterBar) {
    (window as any).__rivareFilterBar = true;

    document.addEventListener('click', (e) => {
      if (!ctx) return;
      const el = e.target as HTMLElement;

      const opener = el.closest<HTMLElement>('[data-filter-open]');
      if (opener) return setOpen(ctx, true, opener.dataset.filterOpen);
      if (el.closest('[data-filter-close]') || el.closest('[data-filter-backdrop]')) return setOpen(ctx, false);
      if (el.closest('[data-filter-clear]')) {
        ctx.genderInputs.forEach((i) => (i.checked = false));
        ctx.scentInputs.forEach((i) => (i.checked = false));
        ctx.applied.gender.clear();
        ctx.applied.scent.clear();
        applyFilters(ctx);
        updatePreview(ctx);
        return;
      }
      if (el.closest('[data-filter-show]')) {
        const draft = draftSets(ctx);
        ctx.applied.gender = draft.gender;
        ctx.applied.scent = draft.scent;
        applyFilters(ctx);
        setOpen(ctx, false);
        return;
      }
    });

    document.addEventListener('change', (e) => {
      if (!ctx) return;
      if ((e.target as HTMLElement).closest('[data-filter-gender],[data-filter-scent]')) updatePreview(ctx);
    });

    document.addEventListener('keydown', (e) => {
      if (ctx && e.key === 'Escape' && ctx.isOpen) setOpen(ctx, false);
    });
    document.addEventListener('astro:after-swap', () => {
      if (ctx?.isOpen) setOpen(ctx, false);
    });
  }

  refresh();
  document.addEventListener('astro:page-load', refresh);
</script>
