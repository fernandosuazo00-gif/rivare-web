---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import ProductCarousel from '@/components/ProductCarousel.astro';
import ValueGrid from '@/components/ValueGrid.astro';
import OurLatestDrops from '@/components/OurLatestDrops.astro';
import CategoryShowcase from '@/components/CategoryShowcase.astro';
import CustomFragranceBlock from '@/components/CustomFragranceBlock.astro';
import { productsByCollection } from '@/data/products';
import { SITE } from '@/data/site';

import heroPoster from '@/assets/editorial/hero-uomo-poster.jpg';
import editorialBiancoPoster from '@/assets/editorial/editorial-bianco-poster.jpg';

const bestsellers = productsByCollection('bestsellers');
---

<Base title={SITE.name} description={SITE.description}>
  <!-- 01 — HERO: full-bleed video, shopping-first --------------------------- -->
  <section class="is-dark relative overflow-hidden h-[calc(100svh-6rem)] min-h-[560px] max-h-[820px] lg:h-[calc(100dvh-7rem)] lg:max-h-[860px]">
    <video
      poster={heroPoster.src}
      autoplay
      muted
      loop
      playsinline
      preload="none"
      data-hero-video
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
    >
      <source src="/videos/hero-uomo.mp4" type="video/mp4" />
    </video>

    <div class="absolute inset-x-0 bottom-0 h-[55%] bg-gradient-to-t from-espresso/90 via-espresso/25 to-transparent" aria-hidden="true"></div>

    <div class="relative z-10 h-full u-shell flex flex-col justify-end pb-8 sm:pb-11 lg:pb-16">
      <h1 class="reveal font-display font-light text-display-lg max-w-[15ch] sm:max-w-[18ch]">
        Fragancias inspiradas en los grandes.
      </h1>
      <p class="reveal mt-3 font-display italic text-display-sm text-caramel">
        Una perfumería hecha en Honduras.
      </p>
      <div class="reveal mt-7 sm:mt-8 grid grid-cols-2 gap-3 max-w-[420px]">
        <a href="/perfumes" class="btn px-4 sm:px-6">Comprar ahora</a>
        <a href="/perfumes/bestsellers" class="btn btn--ghost px-4 sm:px-6">Ver bestsellers</a>
      </div>
    </div>
  </section>

  <!-- 01b — VALUE GRID: brand credibility, 4-card ---------------------------- -->
  <ValueGrid />

  <!-- 01c — OUR LATEST DROPS: portrait lifestyle carousel -------------------- -->
  <OurLatestDrops />

  <!-- 01d — CATEGORY SHOWCASE: women / men / unisex, editorial photography --- -->
  <CategoryShowcase />

  <!-- 02 — BESTSELLERS ------------------------------------------------------ -->
  <section class="u-section" aria-labelledby="favoritos-title">
    <div class="u-shell flex flex-wrap items-end justify-between gap-6 mb-10">
      <div>
        <p class="eyebrow reveal">Bestsellers</p>
        <h2 id="favoritos-title" class="reveal mt-4 font-display text-display-md">Los favoritos de RIVÂRE</h2>
      </div>
      <a href="/perfumes/bestsellers" class="reveal inline-flex items-center gap-2 text-meta uppercase tracking-[0.16em] shrink-0">
        <span class="link-underline">Ver todos</span>
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
    <ProductCarousel products={bestsellers} eager={2} />
  </section>

  <!-- 06 — EDITORIAL VIDEO CAMPAIGN ------------------------------------------- -->
  <section
    class="relative overflow-hidden bg-espresso h-[92svh] min-h-[600px] max-h-[920px] lg:h-[86vh] lg:min-h-[620px] lg:max-h-[820px]"
    aria-labelledby="marca-title"
  >
    <video
      poster={editorialBiancoPoster.src}
      autoplay
      muted
      loop
      playsinline
      preload="none"
      data-editorial-video
      class="absolute inset-0 w-full h-full object-cover object-[50%_38%] lg:object-[50%_60%]"
      aria-hidden="true"
    >
      <source src="/videos/editorial-bianco.mp4" type="video/mp4" />
    </video>

    <div
      class="absolute inset-x-0 top-0 h-[50%] bg-gradient-to-b from-espresso/70 via-espresso/15 to-transparent pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-y-0 left-0 w-[75%] sm:w-[55%] bg-gradient-to-r from-espresso/55 via-espresso/10 to-transparent pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 h-full u-shell flex flex-col justify-start pt-10 sm:pt-14 lg:pt-20">
      <h2
        id="marca-title"
        class="reveal font-sans font-bold uppercase text-ivory leading-[1.08] tracking-tight text-[1.85rem] sm:text-[2.4rem] lg:text-[3.4rem] max-w-[15ch] sm:max-w-[20ch]"
      >
        Fragancias inspiradas<br />en los grandes.
      </h2>
      <p class="reveal mt-4 sm:mt-5 max-w-[30ch] sm:max-w-[38ch] text-ivory/85 text-[0.9rem] sm:text-[1.05rem] leading-relaxed">
        Una perfumería hecha en Honduras. Fragancias inspiradas en aromas que ya conocés, hechas para acompañarte todos los días.
      </p>
      <a
        href="/nosotros"
        class="reveal mt-6 sm:mt-7 inline-flex items-center text-ivory text-[0.8rem] sm:text-[0.85rem] uppercase tracking-[0.16em] underline underline-offset-4 decoration-ivory/60 hover:decoration-ivory hover:text-caramel transition-colors w-fit"
      >
        Nosotros
      </a>
    </div>
  </section>

  <!-- 08 — FRAGANCIAS A MEDIDA ------------------------------------------------ -->
  <CustomFragranceBlock />

  <script>
    // Load + play the hero/editorial videos only once they're actually near the viewport,
    // and only when the visitor hasn't asked for reduced motion — keeps the mobile homepage light.
    function initLazyVideos() {
      const vids = document.querySelectorAll<HTMLVideoElement>('[data-hero-video], [data-editorial-video]');
      if (!vids.length) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      vids.forEach((v) => {
        if (reduced) {
          v.removeAttribute('autoplay');
          return;
        }
        if (!('IntersectionObserver' in window)) {
          v.preload = 'auto';
          v.play().catch(() => {});
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                v.preload = 'auto';
                if (!v.src && !v.currentSrc) v.load();
                v.play().catch(() => {});
              } else {
                v.pause();
              }
            });
          },
          { rootMargin: '200px 0px' },
        );
        io.observe(v);
      });
    }
    initLazyVideos();
    document.addEventListener('astro:page-load', initLazyVideos);
  </script>
</Base>
